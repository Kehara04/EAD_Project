<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/solar_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- SECTION LABEL -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOLAR STATION"
            android:textColor="@color/solar_green"
            android:textSize="11sp"
            android:textStyle="bold" />


        <!-- STATION NAME -->

        <TextView
            android:id="@+id/stationDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Station Name"
            android:textColor="@color/solar_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />


        <!-- ADDRESS -->

        <TextView
            android:id="@+id/stationDetailAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Station address"
            android:textColor="@color/solar_text_secondary"
            android:textSize="15sp" />


        <!-- DIVIDER -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="18dp"
            android:background="@color/solar_border" />


        <!-- CAPACITY -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Capacity"
            android:textColor="@color/solar_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stationDetailCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="300 kW"
            android:textColor="@color/solar_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />


        <!-- AVAILABLE SLOTS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Available slots"
            android:textColor="@color/solar_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stationDetailSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="6 slots available"
            android:textColor="@color/solar_green_dark"
            android:textSize="18sp"
            android:textStyle="bold" />


        <!-- OPERATING HOURS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Operating hours"
            android:textColor="@color/solar_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stationDetailHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="08:00 - 18:00"
            android:textColor="@color/solar_text_primary"
            android:textSize="16sp" />


        <!-- STATUS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Status"
            android:textColor="@color/solar_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stationDetailStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Active"
            android:textColor="@color/solar_green_dark"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- GPS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="GPS location"
            android:textColor="@color/solar_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stationDetailLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="7.2083, 79.8358"
            android:textColor="@color/solar_text_primary"
            android:textIsSelectable="true"
            android:textSize="15sp" />


        <!-- DISTANCE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Distance"
            android:textColor="@color/solar_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Show straight-line distance only when a usable user location is available. -->
        <TextView
            android:id="@+id/stationDetailDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Distance unavailable"
            android:textColor="@color/solar_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- DISTANCE NOTE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/station_distance_note"
            android:textColor="@color/solar_text_secondary"
            android:textSize="12sp" />



        <!-- Report whether the detail sheet refreshed successfully or is showing cached values. -->
        <TextView
            android:id="@+id/stationDetailRefreshStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/solar_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />


        <!-- RESERVATION BUTTON -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonReserveStation"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:text="Reserve this station  →"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/solar_green"
            app:cornerRadius="12dp" />


        <!-- CLOSE BUTTON -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCloseStation"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/station_close"
            android:textAllCaps="false"
            android:textColor="@color/solar_green_dark"
            app:cornerRadius="12dp"
            app:strokeColor="@color/solar_green" />

    </LinearLayout>

</ScrollView>