<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

         //FULL SCREEN BACKGROUND IMAGE
    <ImageView
        android:id="@+id/loginBackgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/smart_solar_mobile_bg" />


         //GREEN OVERLAY FOR CONSISTENCY WITH WEB
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D004D43" />

         //MAIN SCROLLABLE CONTENT
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="34dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

                 //BRAND / LOGO
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:padding="8dp"
                android:contentDescription="@string/smart_solar_logo_description"
                android:scaleType="fitCenter"
                android:src="@drawable/smart_solar_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Microgrid Trading System"
                android:textColor="#D5E8DF"
                android:textSize="14sp" />


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLEAN ENERGY"
                    android:textColor="#D7E8E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:text="•"
                    android:textColor="@color/solar_lime"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONNECTED"
                    android:textColor="#D7E8E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:text="•"
                    android:textColor="@color/solar_lime"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUSTAINABLE"
                    android:textColor="#D7E8E0"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <View
                android:layout_width="34dp"
                android:layout_height="2dp"
                android:layout_marginTop="10dp"
                android:background="@color/solar_lime" />

                 //LOGIN CARD
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="#F7FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="7dp"
                app:strokeColor="#D8E8E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="21dp">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Welcome back"
                        android:textColor="@color/solar_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sign in to continue to your account."
                        android:textColor="@color/solar_text_secondary"
                        android:textSize="13sp" />


                    <!-- EMAIL -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Email address"
                        android:textColor="@color/solar_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />


                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        app:boxBackgroundColor="@color/solar_surface_soft"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/solar_green">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="name@example.com"
                            android:inputType="textEmailAddress"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="@color/solar_text_primary"
                            android:textColorHint="@color/solar_text_light" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- PASSWORD -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Password"
                        android:textColor="@color/solar_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />


                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        app:boxBackgroundColor="@color/solar_surface_soft"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/solar_green"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/solar_green_dark">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter your password"
                            android:inputType="textPassword"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="@color/solar_text_primary"
                            android:textColorHint="@color/solar_text_light" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- ERROR -->

                    <TextView
                        android:id="@+id/textLoginError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@color/solar_error_background"
                        android:padding="10dp"
                        android:textColor="@color/solar_error"
                        android:textSize="12sp"
                        android:visibility="gone" />


                    <!-- LOADING -->

                    <ProgressBar
                        android:id="@+id/loginProgress"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="13dp"
                        android:indeterminateTint="@color/solar_green"
                        android:visibility="gone" />


                    <!-- SIGN IN -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonLogin"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="17dp"
                        android:text="Sign in  →"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/solar_green"
                        app:cornerRadius="12dp" />

                    <!-- FORGOT PASSWORD -->

<com.google.android.material.button.MaterialButton
    android:id="@+id/buttonForgotPassword"
    style="@style/Widget.Material3.Button.TextButton"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginTop="5dp"
    android:text="Forgot password?"
    android:textAllCaps="false"
    android:textColor="@color/solar_green_dark"
    android:textSize="12sp"
    android:textStyle="bold" />


                    <!-- DIVIDER -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/solar_border" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:text="OR"
                            android:textColor="@color/solar_text_light"
                            android:textSize="10sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/solar_border" />

                    </LinearLayout>


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:gravity="center"
                        android:text="Don't have a prosumer account?"
                        android:textColor="@color/solar_text_secondary"
                        android:textSize="12sp" />


                    <!-- REGISTER -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRegister"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:text="Create prosumer account"
                        android:textAllCaps="false"
                        android:textColor="@color/solar_green_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/solar_green"
                        app:strokeWidth="1dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

                 //FOOTER TEXT
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Secure  •  Connected  •  Sustainable"
                android:textColor="#E3F0EA"
                android:textSize="10sp" />


            <!-- Adds breathing space so bottom landscape remains visible -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="90dp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>