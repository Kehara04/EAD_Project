<?xml version="1.0" encoding="utf-8"?>
<!--
    item_station_summary.xml
    Inflation target for each per-station row on the Operator Dashboard.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/solar_border"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/solar_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textSummaryStationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solar Station A"
                android:textColor="@color/solar_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:id="@+id/textSummaryCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 completed today"
            android:textColor="@color/solar_green_dark"
            android:textSize="13sp"
            android:textStyle="bold"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
