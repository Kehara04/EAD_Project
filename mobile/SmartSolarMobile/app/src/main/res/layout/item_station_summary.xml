<?xml version="1.0" encoding="utf-8"?>
<!--
    item_station_summary.xml
    Inflation target for each per-station row on the Operator Dashboard.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="#1A2535">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textSummaryStationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solar Station A"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:id="@+id/textSummaryCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 completed today"
            android:textColor="#52D9A0"
            android:textSize="13sp"
            android:textStyle="bold"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
